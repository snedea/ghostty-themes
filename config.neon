shell-integration-features = no-cursor

# Neon VHS -- retro sunset synthwave with tape wobble and tracking tears
background = #1a1025
foreground = #ffe5f1
cursor-color = #ff6ec7
selection-background = #2d1b40
selection-foreground = #ffe5f1

palette = 0=#1a1025
palette = 1=#ff2e63
palette = 2=#08f7fe
palette = 3=#ff9f1c
palette = 4=#6a3de8
palette = 5=#ff6ec7
palette = 6=#08f7fe
palette = 7=#ffe5f1
palette = 8=#3d2c52
palette = 9=#ff6a88
palette = 10=#5ffbf1
palette = 11=#ffc857
palette = 12=#9d7aff
palette = 13=#ff8fd8
palette = 14=#7dfcff
palette = 15=#ffffff

custom-shader = ~/.config/ghostty/shaders/neon-vhs.glsl
custom-shader-animation = true

background-opacity = 0.97
background-blur = true
minimum-contrast = 1.05

cursor-style = block
cursor-style-blink = true

window-padding-x = 10
window-padding-y = 10
macos-titlebar-style = hidden
